---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Aventuras reais em programação e infra — por Eric de Oliveira Freitas.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Define o tema ANTES da página pintar, pra não dar flash branco no escuro.
         is:inline = roda imediato, não é adiado nem empacotado pelo Astro. -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.theme = saved || (prefersLight ? 'light' : 'dark');
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- open graph básico -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <title>{title}</title>

    <!-- Inter via Google Fonts (troque por self-host depois se quiser) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="prompt">eric</span> ~ blog
        </a>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Alternar entre tema claro e escuro"
        >
          <!-- mostrado no escuro -->
          <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <!-- mostrado no claro -->
          <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
        </button>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        Eric de Oliveira Freitas · aventuras reais em programação e infra<br />
        feito com <a href="https://astro.build">Astro</a> · sem WordPress, de propósito
      </div>
    </footer>

    <script>
      // Troca o tema e lembra a escolha no navegador.
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const atual = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
        const proximo = atual === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = proximo;
        localStorage.setItem('theme', proximo);
      });
    </script>
  </body>
</html>
