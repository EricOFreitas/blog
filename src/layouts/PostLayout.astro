---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
}

const { title, description, date, tags = [] } = Astro.props;

const dataFmt = date.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const metaLine = [dataFmt, ...tags].join(' · ');
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="accent-line"></div>
      <p class="meta">{metaLine}</p>
    </header>

    <div class="prose">
      <slot />
    </div>

    <a class="back-link" href="/">cd ..</a>
  </article>
</BaseLayout>
