---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getVisiblePosts } from '../lib/posts';

const posts = await getVisiblePosts();
---

<BaseLayout title="Eric de Oliveira Freitas — blog">
  <section class="intro">
    <h1>Aventuras reais em programação, infra e além</h1>
    <p>Incidentes, decisões e projetos que realmente aconteceram. Sem tutorial de CRUD.</p>
  </section>

  <PostList posts={posts} />
</BaseLayout>
